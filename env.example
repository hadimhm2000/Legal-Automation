# ── ربات دوم: اتوماسیون ویژه خدمات حقوقی ──
LEGAL_BOT_TOKEN=
BALE_API_BASE=https://tapi.bale.ai
ADMIN_ID=                    # آیدی عددی بله‌ی مدیر
BETA_IDS=                    # فهرست مجاز با ویرگول (فعلاً خالی = فقط مدیر)
HANDOFF_SECRET=              # راز مشترک با ربات اصلی (همان مقدار در .env ربات اصلی)
REQUIRE_HANDOFF=1            # 0 = /start بدون لینک ربات اصلی هم برای اعضای بتا پذیرفته شود (فقط تست)
DB_PATH=./data/legal.db
LOG_DIR=./logs

# پرداخت کارت‌به‌کارت
CARD_NUMBER=
CARD_HOLDER=
CARD_BANK=
INVOICE_EXPIRE_HOURS=48
TEST_PRICE_TOMAN=0           # مثلاً 1000 تا مدیر کل مسیر پرداخت را با مبلغ کم تست کند

# قیمت‌ها (تومان)
TRIAL_DAYS=3
PRICE_NOTICES=500000
PRICE_CASE_ALERTS=500000
PRICE_BOTH=800000
PRICE_TURN=70000             # هر درخواست ثبت نوبت قضائی
SUB_DAYS=30

# زمان‌بندی (تهران)
CHECK_TIMES=08:00,18:00
CASE_TRACK_TIME=08:00
REMINDER_TIME=09:00
MAX_CHECKS_PER_USER_PER_DAY=6
MAX_CONCURRENT_BROWSERS=2

# مرورگر و ورود
HEADLESS=1
IGNORE_HTTPS_ERRORS=0         # فقط اگر یک زیردامنه‌ی ادلیران گواهی خراب داشت
ADLIRAN_BASE_URL=https://adliran.ir/
EBLAGH_MAIN_URL=http://eblagh1.adliran.ir
LOGIN_STEP_TIMEOUT_SEC=300
JOB_TOTAL_TIMEOUT_SEC=3600
MAX_PASSWORD_ATTEMPTS=3
MAX_OTP_RESENDS=3
MAX_PORTAL_ENTRY_ATTEMPTS=4
TYPE_DELAY_MS=120
STEP_PAUSE_MS=1500
PRINT_RETRY_WAIT_SEC=10
PRINT_MAX_TRIES=3
ATTACHMENT_WAIT_SEC=120
ATTACHMENT_MAX_TRIES=3
DATE_WINDOW_DAYS=30
TURN_MAX_SLOT_TRIES=8

