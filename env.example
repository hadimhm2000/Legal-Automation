# ── ربات دوم: اتوماسیون ویژه خدمات حقوقی ──
LEGAL_BOT_TOKEN=
BALE_API_BASE=https://tapi.bale.ai
ADMIN_ID=                    # آیدی عددی بله‌ی مدیر
BETA_IDS=                    # فهرست مجاز با ویرگول (فعلاً خالی = فقط مدیر)
HANDOFF_SECRET=              # راز مشترک با ربات اصلی (همان مقدار در .env ربات اصلی)
REQUIRE_HANDOFF=1            # 0 = /start بدون لینک ربات اصلی هم برای اعضای بتا پذیرفته شود (فقط تست)
DB_PATH=./data/legal.db
LOG_DIR=./logs

# پرداخت کارت‌به‌کارت (مثل ربات اصلی: تصویر کارت + کپی شماره/مبلغ + رسید + کسری)
CARD_NUMBER=
CARD_HOLDER=
CARD_BANK=
CARD_PAY_BRAND=اتوماسیون ویژه خدمات حقوقی   # نام برند روی تصویر کارت
INVOICE_EXPIRE_HOURS=48
RECEIPT_ARM_SECONDS=900       # اعتبار دکمه‌ی «ارسال تصویر رسید» (۱۵ دقیقه)
TEST_PRICE_TOMAN=0           # مثلاً 1000 تا مدیر کل مسیر پرداخت را با مبلغ کم تست کند

# ── پلن‌های نهایی ربات (دستور کارفرما — آبان ۱۴۰۵؛ قیمت‌ها به تومان) ──
FREE_INQUIRIES=2              # شروع رایگان: ۲ استعلام برای هر دو بخش (با تأیید شماره موبایل)
PLAN_BASE_INQUIRIES=10        # پلن پایه (شخصی)
PLAN_BASE_PRICE=600000
PLAN_SELECT_INQUIRIES=20      # پلن برگزیده (شخصی)
PLAN_SELECT_PRICE=1050000
PLAN_PRO_QUOTA=30             # پلن پیشرو: ۳۰ استعلام در ماه + پیگیری خودکار تا ۱۰ پرونده
PLAN_PRO_CASES=10
PLAN_PRO_MONTHLY=2400000
PLAN_PRO_QUARTERLY=6480000    # ۱۰٪ تخفیف ۳ ماهه
PLAN_EXPERT_QUOTA=60          # پلن تخصصی: ۶۰ استعلام در ماه + تا ۳۰ پرونده
PLAN_EXPERT_CASES=30
PLAN_EXPERT_MONTHLY=4000000
PLAN_EXPERT_QUARTERLY=10800000
PLAN_ORG_QUOTA=0              # پلن سازمانی: نامحدود (۰ = استفاده منصفانه) + تا ۱۰۰ پرونده
PLAN_ORG_CASES=100
PLAN_ORG_MONTHLY=7000000
PLAN_ORG_QUARTERLY=18900000
PLAN_ORG_DAILY_CAP=50         # قاعده ۴: سقف روزانه استعلام دستی سازمانی

PRICE_TURN=70000             # هر درخواست ثبت نوبت قضائی (جداست از پلن‌ها)
SUB_DAYS=30                  # طول دوره‌ی ماهانه
QUARTERLY_DAYS=90            # طول دوره‌ی ۳ ماهه
SUB_GRACE_DAYS=7             # قاعده ۸: نگه‌داشتن پرونده‌های ثبت‌شده بعد از انقضا (روز)

# قاعده ۶: مصرف غیرعادی ← محدودیت موقت + گزارش به مدیر
ABUSE_MANUAL_PER_HOUR=15     # بیش از این تعداد استعلام دستی در ۱ ساعت = مصرف غیرعادی
RESTRICT_HOURS=24            # مدت محدودیت موقت (ساعت)

# زمان‌بندی (تهران)
CHECK_TIMES=08:00,18:00
CASE_TRACK_TIME=08:00
REMINDER_TIME=09:00
MAX_CHECKS_PER_USER_PER_DAY=6

# ── ظرفیت و رم (برای ~۱۰۰ کاربر روی سرور مشترک ۱۶ گیگ) ──
# همه‌ی کارها یک Chromium مشترک دارند و هر کاربر فقط یک context (~۸۰–۱۵۰ مگابایت) می‌گیرد.
MAX_CONCURRENT_BROWSERS=20     # سقف کار مرورگری هم‌زمان؛ بقیه در صف با اعلام جایگاه
MIN_FREE_RAM_MB=2048           # رم آزاد کمتر از این → کار جدید صبر می‌کند (حفظ پروژه‌های دیگر سرور)
QUEUE_POLL_SEC=3
QUEUE_NOTIFY_MIN_SEC=15        # حداقل فاصله‌ی به‌روزرسانی پیام «جایگاه شما در صف»
BROWSER_RECYCLE_AFTER=150      # بعد از این تعداد کار، مرورگر مشترک تازه می‌شود (ضد نشت رم)
PROMPT_SPREAD_SEC=600          # پیام‌های ساعت ۸ و ۱۸ در ۱۰ دقیقه پخش می‌شوند (۰ = همه یک‌جا)
BLOCK_RESOURCE_TYPES=media     # دانلود نشود (عکس هرگز: کپچا). برای صرفه‌ی بیشتر: media,font
BLOCK_TRACKERS=1               # اسکریپت‌های آمار/تبلیغ مسدود

# مرورگر و ورود
# ۰ = مرورگر «قابل‌مشاهده» (پیش‌فرض — برای VPS ویندوزی که می‌خواهید پنجره‌ی ربات را ببینید).
# ربات اصلی (online.judicial.services.ble) با پنجره‌ی وسط صفحه باز است؛ پنجره‌ی
# این ربات گوشه‌ی بالا-چپ باز می‌شود تا با آن قاطی نشود.
# ۱ = نامرئی (headless) — برای سرور بدون نمایشگر / تعداد کاربر بالا.
HEADLESS=0
# پنجره‌ی این ربات گوشه‌ی بالا-چپ باز می‌شود تا با پنجره‌ی ربات اصلی (وسط صفحه) قاطی نشود
BROWSER_WINDOW_POSITION=0,0
BROWSER_WINDOW_SIZE=1366x900
IGNORE_HTTPS_ERRORS=0         # فقط اگر یک زیردامنه‌ی ادلیران گواهی خراب داشت
ADLIRAN_BASE_URL=https://adliran.ir/
EBLAGH_MAIN_URL=http://eblagh1.adliran.ir
LOGIN_STEP_TIMEOUT_SEC=300
JOB_TOTAL_TIMEOUT_SEC=3600
MAX_PASSWORD_ATTEMPTS=3
MAX_OTP_RESENDS=3
MAX_PORTAL_ENTRY_ATTEMPTS=4

# رفتار انسانی — سرعت پایین، مکث تصادفی، انتظار برای لود کامل و ظاهر شدن دکمه‌ها
TYPE_DELAY_MS=120              # پایه‌ی تاخیر تایپ هر نویسه (با جیتر: ۱۲۰ تا ۲۴۰ms)
STEP_PAUSE_MS=1500            # پایه‌ی مکث بین مراحل (با جیتر: ۱٫۵ تا ۳ ثانیه)
HUMAN_JITTER=1.0              # سهم تصادفی (۱٫۰ = تا ۱۰۰٪ اضافه بر پایه)
SPEED_FACTOR=1.0              # ضریب کلی سرعت؛ بزرگ‌تر = کندتر (مثلاً ۱٫۵ برای دیده‌شدن بهتر)
PAGE_SETTLE_MS=1500           # مکث بعد از لود کامل هر صفحه
SEARCH_WAIT_MS=25000          # حداکثر انتظار برای نتیجه‌ی جستجو/ابلاغیه‌ها (نه زمان ثابت)
PRINT_RETRY_WAIT_SEC=30       # طبق دستور کارفرما: ۳۰ ثانیه بین تلاش‌های «نسخه چاپی»
PRINT_MAX_TRIES=3
ATTACHMENT_WAIT_SEC=120
ATTACHMENT_MAX_TRIES=3
DATE_WINDOW_DAYS=30
TURN_MAX_SLOT_TRIES=8

# بررسی ابلاغیه‌های جدید (دستور کارفرما — آبان ۱۴۰۵)
BADGE_WAIT_SEC=30             # صبر برای لود شدن عدد کارت «ابلاغیه بازنشده» (قبل از ریلود سایت)
EMPTY_LIST_RETRY_SEC=10       # فاصله‌ی فشار دکمه‌ی «۳ ماه قبل» وقتی جدول بعد از بستن مودال خالی ماند

# اطلاع‌رسانی پرونده (resultcase) — منطق A/B/C/D/GGG
RC_PAGE_SIZE=100               # «تعداد نمایش در یک صفحه» همیشه روی ۱۰۰
RC_MAX_PAGES=50                # سقف ورق‌زدن صفحه‌های نتیجه در هر استعلام
RC_QUEUE_WAIT_SEC=60           # «صف پردازش…» → این مقدار صبر و استعلام مجدد (دستور: ۱ دقیقه)
RC_QUEUE_MAX_TRIES=4           # تا جواب بیاید یا «پرونده ای یافت نشد» (۰ = بی‌نهایت توصیه نمی‌شود)
RC_SVC_RETRY_SEC=10            # «تاخیر در اجرای سرویس…» → فاصله‌ی تلاش مجدد همان کار
RC_SVC_MAX_TRIES=3             # بعد از آن: ریلود صفحه و تکرار کل جستجو
RC_SVC_MAX_RESTARTS=2          # سقف ریلود/تکرار از ابتدا
RC_TAB_INFO_WAIT_SEC=30        # صبر برای درج اطلاعات پایین تب جزئیات (روند کاری/آخرین موضوعات)
RC_TAB_MAX_TRIES=5             # اطلاعات نیامد → دوباره همان تب (۳۰ ثانیه × این تعداد)

SUPPORT_PHONE=09306186888
LAVAYEH_BOT=@onlinejudicialservices_bot
